# ==============================================================================
# A VUE Server Environment Variables Example (.env.example)
# Committed to version control. Fill real values in .env.
# NEVER commit real credentials or keys.
# ==============================================================================

# Node & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Trust proxy: false by default (off locally). Set to true or number of hops (e.g. 1) behind reverse proxy (e.g. Vercel)
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT_KB=100
# Web CORS: comma-separated exact origins allowed to call the API from a browser; empty disables all CORS headers
WEB_ALLOWED_ORIGINS=

# Database (Postgres / Neon)
POSTGRES_VERSION=16
POSTGRES_DB=avue_db
POSTGRES_USER=avue_user
# Owner fills POSTGRES_PASSWORD from local secure generator or Neon dashboard
POSTGRES_PASSWORD=
# Pooled connection string used by the app at runtime (transaction mode, pool max 1-2 per instance)
DATABASE_URL=postgresql://avue_user:@localhost:5432/avue_db
# Direct connection string used for migrations and dumps only
DATABASE_DIRECT_URL=postgresql://avue_user:@localhost:5432/avue_db
# Optional read replica URL, defaults to writer if unset
DATABASE_READ_URL=

# Redis (Upstash in production, Docker locally over TCP)
# Owner fills REDIS_PASSWORD from Upstash dashboard or local Redis config
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Argon2 Hashing Constraints
ARGON2_MAX_CONCURRENCY=4
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# Auth Limits & Expirations (AGENTS.md)
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_IDLE_TTL_DAYS=7
SESSION_CACHE_TTL_SECONDS=60
CODE_TTL_SECONDS=300
CODE_RESEND_COOLDOWN_SECONDS=60
MAX_CODE_ATTEMPTS=5
DAILY_CODE_SEND_CAP=5

# Traffic & Booking Limits (AGENTS.md)
HOLD_TTL_SECONDS=600
MAX_SEATS_PER_HOLD=6
WAITING_ROOM_ACTIVE_LIMIT=300
WAITING_ROOM_ADMIT_PER_SEC=10
WAITING_ROOM_SLOT_SECONDS=90
SEAT_MAP_CACHE_SECONDS=1
READ_YOUR_WRITES_PIN_SECONDS=10
IDEMPOTENCY_TTL_HOURS=24

# On-Demand Showtimes (planner horizon and caps)
ON_DEMAND_DAYS=7
ON_DEMAND_MIN_LEAD_MINUTES=60
ON_DEMAND_SLOTS_PER_MOVIE_PER_DAY=2
ON_DEMAND_MAX_SHOWTIMES_PER_MOVIE=30
ON_DEMAND_MAX_NEW_MOVIES_PER_DAY=25
ON_DEMAND_MAX_ACTIVE_SHOWTIMES=1000

# Rate Limits (per minute)
RATE_LIMIT_HOLD_USER=10
RATE_LIMIT_HOLD_IP=120
RATE_LIMIT_CHECKOUT_USER=5
RATE_LIMIT_CHECKOUT_IP=20
RATE_LIMIT_SEARCH_USER=30
RATE_LIMIT_SEARCH_IP=30
RATE_LIMIT_AUTH_IP=30
RATE_LIMIT_ONDEMAND_USER=5
RATE_LIMIT_ONDEMAND_IP=20

# Search Constants
SEARCH_CACHE_TTL_SECONDS=600

# External Third Parties & APIs (Secrets left empty with source comment)
# Owner fills TMDB_ACCESS_TOKEN from TMDB developer portal (backend only)
TMDB_ACCESS_TOKEN=

# Owner fills FLUTTERWAVE keys and secret hash from Flutterwave dashboard (test mode)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
PAYMENT_SIMULATOR=true
# Public HTTPS base URL used for Flutterwave redirects; blank keeps local HOST/PORT fallback
PUBLIC_API_URL=
# App return URL; blank defaults to avue://payment-return (Expo Go testing needs the dev value)
APP_RETURN_URL=

# Owner fills GOOGLE_CLIENT_ID from Google Cloud Console credentials
GOOGLE_CLIENT_ID=

# Email / SMTP (Mailpit locally, Brevo/Mailjet free relay in prod)
SMTP_HOST=localhost
SMTP_PORT=1025
# Owner fills SMTP_USER from Brevo/relay credentials; empty for local Mailpit
SMTP_USER=
# Owner fills SMTP_PASS from Brevo/relay credentials; empty for local Mailpit
SMTP_PASS=
MAIL_FROM=no-reply@avue.app
# Smoke test recipient (name only, no value)
MAIL_TEST_TO=

# Observability (Hosted scrubbed error tracking)
# Owner fills ERROR_TRACKING_DSN from Sentry / error tracking provider
ERROR_TRACKING_DSN=


# Assistant (Ask A VUE, Gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Per-attempt deadline in ms (integer 2000-15000, default 15000); code enforces a 10000 ms minimum. Leave blank to use the default.
GEMINI_ATTEMPT_TIMEOUT_MS=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
ASSISTANT_RATE_USER_PER_MIN=10
ASSISTANT_RATE_IP_PER_MIN=30
