{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A VUE shared cinema, showtimes, holds, checkout & ticket contract fixtures",
  "cases": {
    "showtimeItem": [
      {
        "description": "Valid showtime item with all required fields",
        "input": {
          "id": "11111111-1111-1111-1111-111111111111",
          "movieId": "550",
          "cinemaId": "22222222-2222-2222-2222-222222222222",
          "cinemaName": "Grand Cinema Victoria Island",
          "city": "Lagos",
          "hallId": "33333333-3333-3333-3333-333333333333",
          "hallName": "Grand Hall 1",
          "startsAt": "2026-11-20T18:00:00.000Z",
          "priceKobo": 450000,
          "isCancelled": false
        },
        "expectedValid": true
      },
      {
        "description": "Invalid showtime item: negative priceKobo",
        "input": {
          "id": "11111111-1111-1111-1111-111111111111",
          "movieId": "550",
          "cinemaId": "22222222-2222-2222-2222-222222222222",
          "cinemaName": "Grand Cinema",
          "city": "Lagos",
          "hallId": "33333333-3333-3333-3333-333333333333",
          "hallName": "Hall 1",
          "startsAt": "2026-11-20T18:00:00.000Z",
          "priceKobo": -100,
          "isCancelled": false
        },
        "expectedValid": false
      }
    ],
    "ensureMovieShowtimesResponse": [
      {
        "description": "Valid ensure response: showtimes created",
        "input": {
          "created": 4
        },
        "expectedValid": true
      },
      {
        "description": "Valid ensure response: nothing created with a reason",
        "input": {
          "created": 0,
          "reason": "NO_CAPACITY"
        },
        "expectedValid": true
      },
      {
        "description": "Invalid ensure response: negative created count",
        "input": {
          "created": -1
        },
        "expectedValid": false
      },
      {
        "description": "Invalid ensure response: unknown reason",
        "input": {
          "created": 0,
          "reason": "SOMETHING_ELSE"
        },
        "expectedValid": false
      }
    ],
    "seatMapItem": [
      {
        "description": "Valid available seat",
        "input": {
          "id": "44444444-4444-4444-4444-444444444444",
          "row": "E",
          "number": 7,
          "accessible": false,
          "state": "available"
        },
        "expectedValid": true
      },
      {
        "description": "Valid wheelchair seat",
        "input": {
          "id": "55555555-5555-5555-5555-555555555555",
          "row": "A",
          "number": 1,
          "accessible": true,
          "state": "available"
        },
        "expectedValid": true
      },
      {
        "description": "Invalid seat: unknown state",
        "input": {
          "id": "44444444-4444-4444-4444-444444444444",
          "row": "E",
          "number": 7,
          "accessible": false,
          "state": "reserved_unknown"
        },
        "expectedValid": false
      }
    ],
    "holdSeatsBody": [
      {
        "description": "Valid hold request for 2 seats",
        "input": {
          "seatIds": [
            "44444444-4444-4444-4444-444444444444",
            "55555555-5555-5555-5555-555555555555"
          ],
          "waitingRoomPass": "pass_token_xyz"
        },
        "expectedValid": true
      },
      {
        "description": "Invalid hold request: exceeds max 6 seats",
        "input": {
          "seatIds": [
            "11111111-1111-1111-1111-111111111111",
            "22222222-2222-2222-2222-222222222222",
            "33333333-3333-3333-3333-333333333333",
            "44444444-4444-4444-4444-444444444444",
            "55555555-5555-5555-5555-555555555555",
            "66666666-6666-6666-6666-666666666666",
            "77777777-7777-7777-7777-777777777777"
          ]
        },
        "expectedValid": false
      },
      {
        "description": "Invalid hold request: empty seatIds",
        "input": {
          "seatIds": []
        },
        "expectedValid": false
      }
    ],
    "checkoutBody": [
      {
        "description": "Valid checkout request for 1 seat",
        "input": {
          "showtimeId": "11111111-1111-1111-1111-111111111111",
          "seatIds": ["44444444-4444-4444-4444-444444444444"]
        },
        "expectedValid": true
      },
      {
        "description": "Invalid checkout request: missing showtimeId",
        "input": {
          "seatIds": ["44444444-4444-4444-4444-444444444444"]
        },
        "expectedValid": false
      }
    ],
    "ticketItem": [
      {
        "description": "Valid active ticket item",
        "input": {
          "id": "88888888-8888-8888-8888-888888888888",
          "bookingId": "99999999-9999-9999-9999-999999999999",
          "showtimeId": "11111111-1111-1111-1111-111111111111",
          "movieTitle": "Gladiator II",
          "cinemaName": "Grand Cinema Victoria Island",
          "hallName": "Grand Hall 1",
          "row": "G",
          "number": 12,
          "startsAt": "2026-11-20T18:00:00.000Z",
          "status": "active",
          "createdAt": "2026-11-14T10:00:00.000Z"
        },
        "expectedValid": true
      },
      {
        "description": "Valid used ticket item with usedAt",
        "input": {
          "id": "88888888-8888-8888-8888-888888888888",
          "bookingId": "99999999-9999-9999-9999-999999999999",
          "showtimeId": "11111111-1111-1111-1111-111111111111",
          "movieTitle": "Gladiator II",
          "cinemaName": "Grand Cinema",
          "hallName": "Hall 1",
          "row": "G",
          "number": 12,
          "startsAt": "2026-11-20T18:00:00.000Z",
          "status": "used",
          "createdAt": "2026-11-14T10:00:00.000Z",
          "usedAt": "2026-11-20T17:45:00.000Z"
        },
        "expectedValid": true
      },
      {
        "description": "Invalid ticket item: invalid status 'issued'",
        "input": {
          "id": "88888888-8888-8888-8888-888888888888",
          "bookingId": "99999999-9999-9999-9999-999999999999",
          "showtimeId": "11111111-1111-1111-1111-111111111111",
          "cinemaName": "Grand Cinema",
          "hallName": "Hall 1",
          "row": "G",
          "number": 12,
          "startsAt": "2026-11-20T18:00:00.000Z",
          "status": "issued",
          "createdAt": "2026-11-14T10:00:00.000Z"
        },
        "expectedValid": false
      }
    ]
  }
}

